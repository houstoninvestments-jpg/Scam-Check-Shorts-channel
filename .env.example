# Names only. Real values go in GitHub Actions secrets (Settings > Secrets and variables > Actions).
# Never commit a filled-in copy of this file.

# Writer and checker models
ANTHROPIC_API_KEY=

# Voice (existing ElevenLabs Creator plan). Without these, the free Kokoro voice is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# YouTube upload and analytics (from the one-time authorization)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Free database for round signups and Family Pass (public values; safe in the browser)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Family Pass, Stripe TEST mode only (setup script refuses live keys)
STRIPE_SECRET_KEY=
