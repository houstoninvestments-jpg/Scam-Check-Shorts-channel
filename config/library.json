    { "kind": "ftc", "name": "FTC Consumer Advice", "base": "https://consumer.ftc.gov", "pattern": "/articles/[a-z0-9-]+", "pages": ["https://consumer.ftc.gov/features/scam-alerts", "https://consumer.ftc.gov/scams"] },
    { "kind": "gov", "name": "FBI Internet Crime Complaint Center (IC3)", "base": "https://www.ic3.gov", "pattern": "/PSA/20\\d{2}/PSA\\d{6}", "pages": ["https://www.ic3.gov/PSA"] },
