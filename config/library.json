{
  "_note": "Evergreen library: official pages that document scams people get right now. Built and topped up by `npx tsx src/cli.ts library-refresh` in GitHub Actions. Each page is kept whole (capture 'page') so every quote can be checked word for word. A page that blocks us is skipped, never worked around.",
  "minEntries": 60,
  "refreshDays": 7,
  "maxAgeYears": 3,
