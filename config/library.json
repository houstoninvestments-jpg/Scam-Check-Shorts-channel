    { "kind": "gov", "name": "CFPB", "base": "https://www.consumerfinance.gov", "pattern": "/(about-us/blog|consumer-tools/fraud)/[a-z0-9-]*(scam|fraud)[a-z0-9-]*/", "pages": ["https://www.consumerfinance.gov/consumer-tools/fraud/", "https://www.consumerfinance.gov/about-us/blog/"] },
